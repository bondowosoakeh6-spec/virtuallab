    "db:generate": "npx prisma generate",
    "test:calc": "npx tsx src/lib/calculations/engine.test.ts",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "test:acceptance": "npx vitest run tests/calculations/",
    "test:excel": "npx vitest run tests/excel-validation/",
    "test:coverage": "npx vitest run --coverage",
    "test:integration": "npx vitest run tests/integration/",
    "test:e2e": "npx playwright test",
    "validate:excel": "npx tsx scripts/validate-against-excel.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
