    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.53.0",
