# ============================================================
# VirtualLab AKUANALIS - Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!

# ========================
# DATABASE
# ========================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/virtuallab_akuanalis"

# ========================
# AUTHENTICATION
# ========================
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-secure-random-string-here"
NEXTAUTH_SECRET="generate-a-secure-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# ========================
# APPLICATION
# ========================
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ========================
# RATE LIMITING
# ========================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ========================
# SECURITY
# ========================
# CSRF secret for additional protection
CSRF_SECRET="generate-another-secure-string"
# Bcrypt salt rounds
BCRYPT_SALT_ROUNDS=12

# ========================
# OPTIONAL: EMAIL (for future use)
# ========================
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
# ========================
# DOCKER / REDIS
# ========================
REDIS_URL="redis://localhost:6379"

# ========================
# BACKUP
# ========================
# BACKUP_DIR=/backups
# BACKUP_RETENTION_DAYS=30
