// VirtualLab AKUANALIS - Prisma Schema
// Generated for PostgreSQL
// WARNING: This schema replaces the previous version with a normalized architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  INSTRUCTOR
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum SubmissionStatus {
  DRAFT
  AVAILABLE
  STARTED
  IN_PROGRESS
  READY_TO_SUBMIT
  SUBMITTED
  GRADED
  RETURNED
  RESUBMITTED
}

enum CalculationStatus {
  SUCCESS
  ERROR
  PARTIAL
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  NUMERIC
}

// ============================================================
// USER & AUTHENTICATION
// ============================================================

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?    @map("avatar_url")

  student      Student?
  instructor   Instructor?

  auditLogs    AuditLog[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("users")
}

model Student {
  id            String @id @default(cuid())
  userId        String @unique @map("user_id")
  studentNumber String @unique @map("student_number")
  program       String?
  semester      Int?

  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)

  memberships   ClassMember[]
  sessions      ExperimentSession[]
  submissions   Submission[]
  quizAttempts  QuizAttempt[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([studentNumber])
  @@map("students")
}

model Instructor {
  id              String  @id @default(cuid())
  userId          String  @unique @map("user_id")
  employeeNumber  String? @unique @map("employee_number")
  expertise       String?

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  classes         Class[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("instructors")
}

// ============================================================
// CLASS MANAGEMENT
// ============================================================

model Class {
  id           String @id @default(cuid())
  name         String
  code         String @unique
  course       String
  semester     String?
  academicYear String? @map("academic_year")

  instructorId String     @map("instructor_id")
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  members      ClassMember[]
  experiments  Experiment[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@index([instructorId])
  @@map("classes")
}

model ClassMember {
  id        String @id @default(cuid())

  classId   String @map("class_id")
  studentId String @map("student_id")

  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now()) @map("joined_at")

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
  @@map("class_members")
}

// ============================================================
// LAB MODULES & EXPERIMENTS
// ============================================================

model LabModule {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  category    String
  description String?
  theory      String? @db.Text
  procedure   String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  experiments Experiment[]
  formulas    Formula[]
  quizzes     Quiz[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("lab_modules")
}

model Experiment {
  id           String  @id @default(cuid())

  moduleId     String  @map("module_id")
  classId      String  @map("class_id")

  title        String
  description  String?
  instructions String? @db.Text

  maxScore     Decimal  @db.Decimal(10, 2) @map("max_score")
  deadline     DateTime?
  isPublished  Boolean  @default(false) @map("is_published")

  module       LabModule @relation(fields: [moduleId], references: [id])
  class        Class     @relation(fields: [classId], references: [id])

  sessions     ExperimentSession[]
  submissions  Submission[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([classId])
  @@index([moduleId])
  @@map("experiments")
}

// ============================================================
// EXPERIMENT SESSIONS & DATA
// ============================================================

model ExperimentSession {
  id           String        @id @default(cuid())

  experimentId String        @map("experiment_id")
  studentId    String        @map("student_id")

  status       SessionStatus @default(IN_PROGRESS)

  startedAt    DateTime      @default(now()) @map("started_at")
  completedAt  DateTime?     @map("completed_at")

  experiment   Experiment @relation(fields: [experimentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])

  inputs       ExperimentInput[]
  calculations CalculationResult[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([experimentId])
  @@map("experiment_sessions")
}

model ExperimentInput {
  id        String   @id @default(cuid())

  sessionId String   @map("session_id")
  parameter String
  value     Decimal? @db.Decimal(30, 12)
  textValue String?  @map("text_value")
  unit      String?

  session   ExperimentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("experiment_inputs")
}

model CalculationResult {
  id            String            @id @default(cuid())

  sessionId     String            @map("session_id")

  calculationId String            @map("calculation_id")
  formula       String
  inputSnapshot Json              @map("input_snapshot")
  intermediate  Json?
  result        Decimal?          @db.Decimal(30, 12)
  unit          String?
  status        CalculationStatus @default(SUCCESS)

  session       ExperimentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now()) @map("created_at")

  @@map("calculation_results")
}

// ============================================================
// SUBMISSIONS & GRADING
// ============================================================

model Submission {
  id           String           @id @default(cuid())

  experimentId String           @map("experiment_id")
  studentId    String           @map("student_id")

  sessionId    String?          @map("session_id")

  submittedAt  DateTime?        @map("submitted_at")
  status       SubmissionStatus @default(DRAFT)

  reportUrl    String?          @map("report_url")

  resubmissionAllowed Boolean @default(false) @map("resubmission_allowed")

  experiment   Experiment @relation(fields: [experimentId], references: [id])
  student      Student    @relation(fields: [studentId], references: [id])

  grade        Grade?

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([experimentId])
  @@map("submissions")
}

model Grade {
  id           String   @id @default(cuid())

  submissionId String   @unique @map("submission_id")

  preTest      Decimal? @db.Decimal(5, 2) @map("pre_test")
  practical    Decimal? @db.Decimal(5, 2)
  calculation  Decimal? @db.Decimal(5, 2)
  report       Decimal? @db.Decimal(5, 2)
  postTest     Decimal? @db.Decimal(5, 2) @map("post_test")

  total        Decimal  @db.Decimal(5, 2)

  feedback     String?  @db.Text

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("grades")
}

// ============================================================
// QUIZZES
// ============================================================

model Quiz {
  id           String  @id @default(cuid())

  moduleId     String  @map("module_id")

  title        String
  description  String?
  timeLimit    Int?    @map("time_limit")  // in minutes
  passingScore Int     @default(60) @map("passing_score")
  isActive     Boolean @default(true) @map("is_active")

  module       LabModule @relation(fields: [moduleId], references: [id])

  questions    QuizQuestion[]
  attempts     QuizAttempt[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("quizzes")
}

model QuizQuestion {
  id            String       @id @default(cuid())

  quizId        String       @map("quiz_id")

  questionText  String       @db.Text @map("question_text")
  questionType  QuestionType @default(MULTIPLE_CHOICE) @map("question_type")
  options       Json?        // JSON array of option strings
  correctAnswer String       @map("correct_answer")
  explanation   String?      @db.Text
  points        Int          @default(10)
  orderIndex    Int          @default(0) @map("order_index")

  quiz          Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  answers       QuizAnswer[]

  createdAt     DateTime @default(now()) @map("created_at")

  @@map("quiz_questions")
}

model QuizAttempt {
  id          String    @id @default(cuid())

  quizId      String    @map("quiz_id")
  studentId   String    @map("student_id")

  score       Int?      @default(0)
  passed      Boolean   @default(false)

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  quiz        Quiz    @relation(fields: [quizId], references: [id])
  student     Student @relation(fields: [studentId], references: [id])

  answers     QuizAnswer[]

  createdAt   DateTime @default(now()) @map("created_at")

  @@map("quiz_attempts")
}

model QuizAnswer {
  id            String  @id @default(cuid())

  attemptId     String  @map("attempt_id")
  questionId    String  @map("question_id")

  answer        String
  isCorrect     Boolean @default(false) @map("is_correct")
  pointsAwarded Int     @default(0) @map("points_awarded")

  attempt       QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      QuizQuestion @relation(fields: [questionId], references: [id])

  createdAt     DateTime @default(now()) @map("created_at")

  @@map("quiz_answers")
}

// ============================================================
// SCIENTIFIC DATABASE
// ============================================================

model ChemicalElement {
  id            String  @id @default(cuid())

  atomicNumber  Int     @map("atomic_number")
  symbol        String  @unique
  name          String
  atomicMass    Decimal @db.Decimal(12, 6) @map("atomic_mass")

  groupName     String? @map("group_name")
  period        Int?
  category      String?

  compoundParts CompoundElement[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("chemical_elements")
}

model ChemicalCompound {
  id          String  @id @default(cuid())

  name        String
  formula     String  @unique
  molarMass   Decimal @db.Decimal(12, 6) @map("molar_mass")
  description String?

  elements    CompoundElement[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("chemical_compounds")
}

model CompoundElement {
  id         String @id @default(cuid())

  compoundId String @map("compound_id")
  elementId  String @map("element_id")
  quantity   Int    @default(1)

  compound   ChemicalCompound @relation(fields: [compoundId], references: [id], onDelete: Cascade)
  element    ChemicalElement  @relation(fields: [elementId], references: [id])

  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([compoundId, elementId])
  @@map("compound_elements")
}

model LuffSchoorlTable {
  id          String @id @default(cuid())
  name        String
  description String?

  values      LuffSchoorlValue[]

  createdAt   DateTime @default(now()) @map("created_at")

  @@map("luff_schoorl_tables")
}

model LuffSchoorlValue {
  id         String   @id @default(cuid())

  tableId    String   @map("table_id")

  volumeMl   Decimal  @db.Decimal(10, 4) @map("volume_ml")

  glucoseMg  Decimal? @db.Decimal(10, 4) @map("glucose_mg")
  lactoseMg  Decimal? @db.Decimal(10, 4) @map("lactose_mg")
  maltoseMg  Decimal? @db.Decimal(10, 4) @map("maltose_mg")

  table      LuffSchoorlTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")

  @@map("luff_schoorl_values")
}

model ProteinConversionFactor {
  id       String  @id @default(cuid())
  foodType String  @unique @map("food_type")
  factor   Decimal @db.Decimal(6, 4)
  source   String?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("protein_conversion_factors")
}

model ConversionFactor {
  id          String  @id @default(cuid())
  category    String
  fromUnit    String  @map("from_unit")
  toUnit      String  @map("to_unit")
  factor      Decimal @db.Decimal(20, 10)
  description String?

  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([category, fromUnit, toUnit])
  @@map("conversion_factors")
}

// ============================================================
// FORMULAS
// ============================================================

model Formula {
  id          String  @id @default(cuid())

  moduleId    String  @map("module_id")

  code        String  @unique
  name        String
  description String?

  expression  String  @db.Text
  unit        String?

  sourceFile  String? @map("source_file")
  sourceSheet String? @map("source_sheet")
  sourceCell  String? @map("source_cell")

  isSystem    Boolean @default(true) @map("is_system")
  isActive    Boolean @default(true) @map("is_active")

  module      LabModule @relation(fields: [moduleId], references: [id])

  versions    FormulaVersion[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("formulas")
}

model FormulaVersion {
  id            String @id @default(cuid())

  formulaId     String @map("formula_id")
  version       Int

  expression    String @db.Text
  sourceCell    String? @map("source_cell")
  sourceFormula String? @db.Text @map("source_formula")

  createdAt     DateTime @default(now()) @map("created_at")

  formula       Formula @relation(fields: [formulaId], references: [id], onDelete: Cascade)

  @@unique([formulaId, version])
  @@map("formula_versions")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())

  userId    String?  @map("user_id")

  action    String
  entity    String
  entityId  String?  @map("entity_id")

  metadata  Json?

  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  user      User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
